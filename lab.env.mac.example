# macOS / Docker Desktop lab.env template.
#   cp lab.env.mac.example lab.env
#
# VIN and app family are passed on the CLI:
#   ./scripts/up-car.sh --vin <VIN> --apps gai_EV|gai_ICE|prod_EV|prod_ICE
#
# LABBUS_NAME / LABSHIM_NAME are unused on macOS (no host-net.sh bridge/shim).
# LAB_GATEWAY is the MQTT socat target + Autrio host hint (host.docker.internal),
# not a Docker network gateway setting.

LABBUS_NAME=labbus
LABSHIM_NAME=labshim
LABNET_NAME=labnet
LAB_SUBNET=10.74.0.0/24
LAB_GATEWAY=host.docker.internal
LAB_SIM_IP=10.74.0.2
LAB_SIM_CONSOLE_PORT=18090
# Car entrypoint socat: 127.0.0.1 → LAB_GATEWAY (Autrio still returns mqtt localhost)
LAB_MQTT_BROKER_PORT=1883

# Keystone defaults (optional if you always pass flags on up-car.sh).
# Per-car VIN: --vin. Per-tenant overrides: --tenant-key --birth-secret --autrio-url
KEYSTONE_AUTRIO_URL=http://host.docker.internal:8002
KEYSTONE_TENANT_KEY=sample-org
KEYSTONE_BIRTH_SECRET=CHANGE_ME_BIRTH_SECRET
KEYSTONE_KEYSTORE_BACKEND=file
